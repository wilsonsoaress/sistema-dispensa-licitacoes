// This is your Prisma schema file,
// learn more about the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  ADMIN
  SOLICITANTE
  AGENTE_CONTRATACAO
  APROVADOR
}

enum ProcessStatus {
  DRAFT
  IN_ANALYSIS
  PRICE_RESEARCH
  SUPPLIER_SELECTED
  AWAITING_APPROVAL
  REJECTED
  APPROVED
  COMPLETED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

enum DocumentType {
  PESQUISA_PRECOS
  JUSTIFICATIVA_PRECO
  RAZAO_ESCOLHA_FORNECEDOR
  DOCUMENTACAO_FORNECEDOR
  PARECER_JURIDICO
  TERMO_REFERENCIA
  OUTRO
}

enum ObjectCategory {
  COMMON_GOODS
  ENGINEERING_WORKS
  GENERAL_SERVICES
  IT_GOODS
  HEALTH_SUPPLIES
  OTHER
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AuditAction {
  PROCESS_CREATED
  PROCESS_UPDATED
  PROCESS_SUBMITTED
  DEMAND_DOCUMENT_CREATED
  DEMAND_DOCUMENT_UPDATED
  QUOTATION_ADDED
  QUOTATION_UPDATED
  SUPPLIER_SELECTED
  DOCUMENT_UPLOADED
  PROCESS_SENT_FOR_APPROVAL
  PROCESS_APPROVED
  PROCESS_REJECTED
  PROCESS_COMPLETED
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id           String @id @default(uuid()) @db.Uuid
  name         String
  email        String @unique
  passwordHash String

  role     UserRole
  isActive Boolean  @default(true)

  departmentId String?     @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id])

  // Processes created by this user
  createdProcesses Process[] @relation("ProcessRequester")

  // Documents uploaded by this user
  uploadedDocuments Document[]

  // Approvals performed by this user
  approvals Approval[]

  // Audit events generated by this user
  auditLogs AuditLog[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]

  @@index([departmentId])
  @@index([role])
  @@index([isActive])
}

// ─────────────────────────────────────────────
// SESSION
// ─────────────────────────────────────────────

model Session {
  sessionId String @id @default(uuid()) @map("session_id") @db.Uuid

  tokenHash String @unique @map("token_hash") @db.VarChar(64)
  userId    String @map("user_id") @db.Uuid

  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idxSessionsUser")
  @@index([expiresAt], name: "idxSessionsExpiresAt")
  @@map("sessions")
}

// ─────────────────────────────────────────────
// DEPARTMENT
// ─────────────────────────────────────────────

model Department {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  users     User[]
  processes Process[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// PROCESS
// ─────────────────────────────────────────────

model Process {
  id String @id @default(uuid()) @db.Uuid

  // Human-readable identifier
  number Int
  year   Int

  title       String
  object      String
  description String?

  legalBasis String?

  estimatedValue Decimal? @db.Decimal(15, 2)

  status ProcessStatus @default(DRAFT)

  // Department responsible for the process
  departmentId String     @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id])

  // User who originally requested the process
  requesterId String @db.Uuid
  requester   User   @relation("ProcessRequester", fields: [requesterId], references: [id])

  quotations Quotation[]
  documents  Document[]
  approvals  Approval[]
  auditLogs  AuditLog[]

  demandDocument DemandDocument?

  // Selected supplier
  selectedSupplierId String?   @db.Uuid
  selectedSupplier   Supplier? @relation("SelectedSupplier", fields: [selectedSupplierId], references: [id])

  supplierJustification String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([number, year])
  @@index([status])
  @@index([departmentId])
  @@index([requesterId])
  @@index([selectedSupplierId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// DEMAND DOCUMENT (DFD)
// ─────────────────────────────────────────────

model DemandDocument {
  id String @id @default(uuid()) @db.Uuid

  processId String  @unique @db.Uuid
  process   Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  category ObjectCategory

  detailedJustification String
  technicalSpecifications String?

  urgency UrgencyLevel @default(MEDIUM)

  budgetSource String?
  desiredDeadlineDays Int?

  responsibleName  String
  responsibleEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([urgency])
}

// ─────────────────────────────────────────────
// SUPPLIER
// ─────────────────────────────────────────────

model Supplier {
  id String @id @default(uuid()) @db.Uuid

  legalName String
  tradeName String?
  cnpj      String  @unique

  email String?
  phone String?

  quotations Quotation[]

  selectedInProcesses Process[] @relation("SelectedSupplier")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([legalName])
}

// ─────────────────────────────────────────────
// QUOTATION
// ─────────────────────────────────────────────

model Quotation {
  id String @id @default(uuid()) @db.Uuid

  processId String  @db.Uuid
  process   Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  supplierId String   @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  description String?

  value Decimal @db.Decimal(15, 2)

  quotedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([processId])
  @@index([supplierId])
}

// ─────────────────────────────────────────────
// DOCUMENT
// ─────────────────────────────────────────────

model Document {
  id String @id @default(uuid()) @db.Uuid

  processId String  @db.Uuid
  process   Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  type DocumentType

  filename   String
  storageKey String
  mimeType   String
  size       Int

  uploadedById String @db.Uuid
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  @@index([processId])
  @@index([type])
  @@index([uploadedById])
}

// ─────────────────────────────────────────────
// APPROVAL
// ─────────────────────────────────────────────

model Approval {
  id String @id @default(uuid()) @db.Uuid

  processId String  @db.Uuid
  process   Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  decision ApprovalDecision
  comment  String?

  createdAt DateTime @default(now())

  @@index([processId])
  @@index([userId])
  @@index([decision])
}

// ─────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  processId String  @db.Uuid
  process   Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  action      AuditAction
  description String?

  createdAt DateTime @default(now())

  @@index([processId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// PASSWORD RESET TOKEN
// ─────────────────────────────────────────────

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
